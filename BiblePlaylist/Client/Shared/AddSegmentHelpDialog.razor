@* #37: one-time explainer for adding a segment in a chapter that is not
   in this playlist yet. Shown from the playlist's "Add segment to a new
   chapter" button; shown once (see NavPlaylistMenu). *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Add a segment</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-2">
            To add a segment from a chapter that is not in this playlist yet:
        </MudText>
        <MudText Typo="Typo.body1">1. Pick the chapter on the Read page.</MudText>
        <MudText Typo="Typo.body1">2. Tap verses to select them.</MudText>
        <MudText Typo="Typo.body1">3. Tap "Add to playlist" and choose this playlist.</MudText>
        <MudText Typo="Typo.body1" Class="mt-2">
            The editor opens with your verses selected — you can adjust them there before saving.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GoToReadPage">Go to Read page</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private void GoToReadPage() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}
