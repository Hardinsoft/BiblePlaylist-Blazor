@using System.Threading
@using BiblePlaylist.Client.Config
@using BiblePlaylist.Client.Events
@using BiblePlaylist.Shared.Bible
@using BiblePlaylist.Shared.DTO
@using BiblePlaylist.Shared.Data
@using BiblePlaylist.Shared.Playlist
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject IJSRuntime js
@inject ILogger<NavBibleMenu> logger
@inject IDelegateLibrary delegateLibrary
@inject Endpoints endpoints
@inject NavigationManager NavManager
@inject ISnackbar Snackbar

<MudGrid Class="sticky-top mud-elevation-4 stick-to-menu-bottom" hidden="@(hideChapters)" Spacing="2">
    <MudItem xs="12">
        <MudGrid id="menuGrid" Spacing="2" >
            <MudItem md="4" xs="12">
                <MudText Typo="Typo.subtitle2" @onclick="ToggleMenu">@selectedPlaylist?.Description</MudText>
            </MudItem>
            <MudItem md="4" xs="12">
                <MudText Typo="Typo.body2" @onclick="ToggleMenu">@chapterText</MudText>
            </MudItem>
        </MudGrid>

        <!-- === REUSABLE AUDIO PLAYER (now supports segments) === -->

            <AudioPlayer @ref="audioPlayer"
                         PlayerId="segmentChapterAudioPlayer"
                         SourceUrl="@chapterAudio"
                         @bind-HasPlayed="HasPlayed"
                         @bind-Autoplay="Autoplay"
                         @bind-Repeat="Repeat"
                         @bind-LoadingTrack="LoadingTrack"
                         SegmentStart="@CurrentSegmentStart"
                         SegmentEnd="@CurrentSegmentEnd"
                         OnEnded="OnTrackEnded"
                         OnPrevious="GoToPreviousSegment"
                         OnNext="GoToNextSegment"
                         OnPlay="PlayCurrentSegment"
                         ShowSettingsToggles="true" />
            
    </MudItem>
</MudGrid>

<!-- Playlist + Chapter/Verse expansion UI -->
<MudGrid Class="mt-1 px-1" hidden="@(!hide)">
    <!-- extra buffer so verses don't sit right under the docked player -->
    <MudItem xs="12">
        <MudList T="string">
            @if (Library != null)
            {            
                foreach (var p in Library.Playlists)
                {
                    <MudListItem Class="mb-5" @onclick="@(e => SelectPlaylist(p))" id="@p.Name.Replace(" ","_")">@p.Name</MudListItem>
                    @if (Library != null && !hideChapters && selectedPlaylist?.Name == p.Name)
                    {
                        <MudItem xs="12" hidden="@hideChapters">
                            <MudGrid>
                                @if (selectedPlaylist != null)
                                {                                   
                                    @if (selectedPlaylist.BookChapters == null || !selectedPlaylist.BookChapters.Any())
                                    {
                                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-4">
                                            No chapters loaded yet.
                                        </MudAlert>
                                    }
                                    else
                                    {
                                        @* Drag-reorder playlist chapters (e.g. John 1:1-9 before/after Luke 2:1-39).
                                           Verses inside a chapter are immutable. *@
                                        <MudDropContainer @ref="_dropContainer"
                                                          T="BookChapter"
                                                          Items="@selectedPlaylist.BookChapters"
                                                          ItemsSelector="@((item, zone) => true)"
                                                          ItemDropped="OnBookChapterDropped"
                                                          Class="d-flex flex-column playlist-chapter-drop-container">
                                            <ChildContent>
                                                <MudDropZone T="BookChapter"
                                                             Identifier="playlist-chapters"
                                                             AllowReorder="true"
                                                             Class="flex-grow-1 chapter-drop-zone" />
                                            </ChildContent>
                                            <ItemRenderer>
                                                <MudExpansionPanel Expanded="IsCurrentChapter(context)" Class="mb-1 playlist-chapter-panel">
                                                    <TitleContent>
                                                        <div class="d-flex align-center gap-2" style="width: 100%;">
                                                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                                                                     Class="mud-text-secondary chapter-drag-handle"
                                                                     Style="cursor: grab; flex-shrink: 0;" />
                                                            <MudText Typo="Typo.subtitle1" Class="flex-grow-1">@context.Display</MudText>
                                                        </div>
                                                    </TitleContent>
                                                    <ChildContent>
                                                        @if (context.Segments == null || !context.Segments.Any())
                                                        {
                                                            <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true">
                                                                No segments defined for this chapter.
                                                            </MudAlert>
                                                        }
                                                        else
                                                        {
                                                            @* Verses are display-only / playable — not draggable *@
                                                            @foreach (var segment in context.Segments)
                                                            {
                                                                <MudPaper Class="@($"pa-2 mb-2 {(IsCurrentSegment(context, segment) ? "current-segment mud-elevation-1" : "")}")"
                                                                          Style="border-radius: 4px; cursor: pointer;"
                                                                          @onclick="@(() => PlaySpecificSegment(context, segment))">
                                                                    <div class="d-flex justify-content-between verse-container">
                                                                        <div class="verse-list">
                                                                            @foreach (var verse in segment.Verses)
                                                                            {
                                                                                bool isPlayingVerse = IsCurrentSegment(context, segment) &&
                                                                                    _currentPlaybackTime >= verse.AudioStart &&
                                                                                    _currentPlaybackTime <= verse.AudioEnd;

                                                                                var verseId = $"verse-{context.ChapterNumber}-{segment.VerseStart}-{verse.Number}";

                                                                                <div id="@verseId" @onclick:stopPropagation="true"
                                                                                     @onclick="@(e => PlaySpecificVerse(context, segment, verse))"
                                                                                     class="d-flex align-start mb-2"
                                                                                     style="@(isPlayingVerse ? "background-color: rgba(var(--mud-palette-primary-rgb), 0.12); border-radius: 4px; padding-left: 8px; margin-left: -4px;" : "")">
                                                                                    <MudText Typo="Typo.body1"
                                                                                             Class="verse-number mr-4 font-weight-medium">
                                                                                        @verse.Number
                                                                                    </MudText>
                                                                                    <div class="flex-grow-1 verse-text" style="font-size: 1.05rem; line-height: 1.55;">
                                                                                        @((MarkupString)verse.Html)
                                                                                    </div>
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                                                                 AriaLabel="Segment options"
                                                                                 @onclick:stopPropagation="true">
                                                                            <MudMenuItem Label="Edit segment"
                                                                                         @onclick="() => NavigateToEdit(context, segment)" />
                                                                            <MudMenuItem Label="Delete segment"
                                                                                         Color="Color.Error"
                                                                                         @onclick="() => DeleteSegment(context, segment)" />
                                                                        </MudMenu>
                                                                    </div>
                                                                </MudPaper>
                                                            }
                                                        }
                                                    </ChildContent>
                                                </MudExpansionPanel>
                                            </ItemRenderer>
                                        </MudDropContainer>
                                    }
                                }
                            </MudGrid>
                        </MudItem>
                    }
                }           
            }
        </MudList>
    </MudItem>


</MudGrid>
<MudPaper Class="mb-5">

</MudPaper>

@code {
    private AudioPlayer audioPlayer;
    private MudDropContainer<BookChapter> _dropContainer;

    private BiblePlaylist.Shared.DTO.SelectedBookChapter SelectedBookChapter { get; set; }
    private BiblePlaylist.Shared.Navigation.BibleMenu bibleMenu { get; set; }
    private string chapterText { get; set; }
    private string chapterAudio { get; set; }
    private string selectedBookRef { get; set; }
    private bool hide { get; set; } = true;
    private bool hideChapters { get; set; } = true;
    private bool hidePlaylists { get; set; } = false;
    private bool hideVerses { get; set; } = true;
    private bool loadingTrack { get; set; } = false;

    private Library Library { get; set; }
    private Playlist selectedPlaylist { get; set; }

    [Parameter]
    public string PlaylistName { get; set; }

    private BiblePlaylist.Shared.Data.UserSettings userSettings;

    private bool _hasPlayed { get; set; } = false;
    public bool HasPlayed
    {
        get => _hasPlayed;
        set
        {            
            OnHasPlayedChanged(value);
        }
    }    

    private bool _autoplay = false;
    public bool Autoplay
    {
        get => _autoplay;
        set
        {
            _autoplay = value;
            _ = AutoplayChanged(value);
        }
    }

    private bool _repeat = false;
    private bool Repeat
    {
        get => _repeat;
        set
        {
            _repeat = value;
            _ = RepeatChanged(value);
        }
    }

    private bool _enableTts = true;
    public bool EnableTts
    {
        get => _enableTts;
        set
        {
            _enableTts = value;
            _ = EnableTtsChanged(value);
        }
    }

    public bool LoadingTrack
    {
        get => loadingTrack;
        set
        {
            SetLoadingTrack(value);
        }
    }


    // === SEGMENT PLAYBACK SUPPORT ===
    private List<(BookChapter Chapter, Segment Segment)> _playlistSegments = new();
    private int _currentSegmentIndex = -1;
    private decimal _currentPlaybackTime;
    private System.Timers.Timer? _playbackTimer;
    private string _currentPlayingVerseId;
    private string _lastScrolledVerseId;

    private (BookChapter Chapter, Segment Segment)? CurrentSegment =>
        (_currentSegmentIndex >= 0 && _currentSegmentIndex < _playlistSegments.Count)
            ? _playlistSegments[_currentSegmentIndex]
            : null;

    private decimal? CurrentSegmentStart => CurrentSegment?.Segment.Verses?.FirstOrDefault()?.AudioStart;
    private decimal? CurrentSegmentEnd => CurrentSegment?.Segment.Verses?.LastOrDefault()?.AudioEnd;

    private bool IsCurrentSegment(BookChapter chapter, Segment segment)
    {
        return CurrentSegment.HasValue &&
               CurrentSegment.Value.Chapter == chapter &&
               CurrentSegment.Value.Segment == segment;
    }

    private bool IsCurrentChapter(BookChapter chapter)
    {
        return CurrentSegment.HasValue && CurrentSegment.Value.Chapter == chapter;
    }

    private void StartPlaybackTimer()
    {
        StopPlaybackTimer();
        _playbackTimer = new System.Timers.Timer(300);
        _playbackTimer.Elapsed += async (_, _) => await UpdatePlaybackPosition();
        _playbackTimer.AutoReset = true;
        _playbackTimer.Start();
    }

    private void StopPlaybackTimer()
    {
        if (_playbackTimer != null)
        {
            _playbackTimer.Stop();
            _playbackTimer.Dispose();
            _playbackTimer = null;
        }
    }

    /// <summary>
    /// Cancels any in-flight TTS/playback and creates a fresh token source.
    /// Also stops the native audio element and speechSynthesis via PauseAsync.
    /// </summary>
    private async Task CancelPlaybackAsync()
    {      

        if (audioPlayer != null)
        {
            await audioPlayer.PauseAsync();
        }

        StopPlaybackTimer();
        OnHasPlayedChanged(false);
        SetLoadingTrack(false);
    }

    private async Task UpdatePlaybackPosition()
    {
        if (CurrentSegment == null || !HasPlayed)
        {
            StopPlaybackTimer();
            return;
        }

        try
        {
            decimal time = await js.InvokeAsync<decimal>("GetAudioCurrentTime");
            if (Math.Abs(time - _currentPlaybackTime) <= 0.05m)
                return;

            _currentPlaybackTime = time;

            // Resolve the active verse from data (not during render) so scroll + highlight stay in sync
            string playingVerseId = null;
            if (CurrentSegment.HasValue)
            {
                var (chapter, segment) = CurrentSegment.Value;
                var verse = segment.Verses?.FirstOrDefault(v =>
                    _currentPlaybackTime >= v.AudioStart &&
                    _currentPlaybackTime <= v.AudioEnd);

                if (verse != null)
                {
                    playingVerseId = $"verse-{chapter.ChapterNumber}-{segment.VerseStart}-{verse.Number}";
                }
            }

            _currentPlayingVerseId = playingVerseId;

            // MudDropContainer does not re-render ItemRenderer on parent StateHasChanged alone.
            // Refresh() forces the verse highlight styles inside the drop items to update.
            await InvokeAsync(() =>
            {
                _dropContainer?.Refresh();
                StateHasChanged();
            });

            if (!string.IsNullOrEmpty(_currentPlayingVerseId) &&
                _currentPlayingVerseId != _lastScrolledVerseId)
            {
                _lastScrolledVerseId = _currentPlayingVerseId;
                await js.InvokeVoidAsync("scrollToVerse", _currentPlayingVerseId);
            }
        }
        catch
        {
            // ignore transient JS interop errors
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (userSettings == null)
            userSettings = await localStorage.GetItemAsync<BiblePlaylist.Shared.Data.UserSettings>("userName_settings");

        if (userSettings == null)
        {
            userSettings = new BiblePlaylist.Shared.Data.UserSettings { Autoplay = _autoplay, Repeat = _repeat, EnableTts = _enableTts };
            await localStorage.SetItemAsync("userName_settings", userSettings);
        }

        Autoplay = userSettings.Autoplay;
        Repeat = userSettings.Repeat;
        _enableTts = userSettings.EnableTts;

        await base.OnParametersSetAsync();


    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        string libraryResponse = await Http.GetStringAsync("library?key=library_greg_hardin_live_com");
        Library = JsonConvert.DeserializeObject<Library>(libraryResponse);
        delegateLibrary.HasPlayedChanged += (o, e) => OnHasPlayedChanged(e.Value);

    }

    private void OnHasPlayedChanged(bool value)
    {
        _hasPlayed = value;
        StateHasChanged();
    }

    private void SetLoadingTrack(bool value)
    {
        loadingTrack = value;
        StateHasChanged();
    }

    protected async Task ToggleMenu()
    {
        ///TODO: Possible future event to open edit menu
    }

    protected async Task SelectPlaylist(Playlist playlist)
    {
        // Always cancel any in-flight TTS/playback first so a previous PlayCurrentSegment
        // cannot resume after its speakSequenceAsync await completes.
        await CancelPlaybackAsync();

        selectedPlaylist = playlist;

        var bookChaptersResponse = await Http.PostAsJsonAsync<IList<BookChapter>>("playlist/inflate?key=NET", selectedPlaylist.BookChapters);
        List<BookChapter> inflatedBookChapters = new List<BookChapter>();

        if (bookChaptersResponse.IsSuccessStatusCode)
            inflatedBookChapters = await bookChaptersResponse.Content.ReadFromJsonAsync<List<BookChapter>>();

        selectedPlaylist.BookChapters.Clear();
        inflatedBookChapters.ForEach(bc => selectedPlaylist.BookChapters.Add(bc));

        // Build flat segment list for sequential playback (respects BookChapters list order)
        RebuildPlaylistSegments();

        _currentSegmentIndex = _playlistSegments.Any() ? 0 : -1;

        hideChapters = !hideChapters;
        await InvokeAsync(StateHasChanged);

        // Auto-start first segment if autoplay is enabled and we just opened the playlist
        if (Autoplay && _currentSegmentIndex >= 0 && !hideChapters)
        {
            await PlayCurrentSegment();
        }
        // else: already cancelled + paused above
    }

    /// <summary>
    /// Rebuild the flat playback list from the current BookChapters / Segments list order.
    /// BookChapter order is authoritative (supports drag-reorder of playlist entries).
    /// </summary>
    private void RebuildPlaylistSegments()
    {
        _playlistSegments.Clear();
        if (selectedPlaylist?.BookChapters == null) return;

        foreach (var chapter in selectedPlaylist.BookChapters)
        {
            if (chapter.Segments == null) continue;
            foreach (var segment in chapter.Segments)
            {
                _playlistSegments.Add((chapter, segment));
            }
        }
    }

    /// <summary>
    /// Called when a playlist chapter (BookChapter) is dropped after a drag.
    /// Reorders selectedPlaylist.BookChapters, rebuilds the flat playback list,
    /// keeps the currently-playing segment index in sync, and auto-saves.
    /// Does NOT interrupt playback of another segment.
    /// </summary>
    private async Task OnBookChapterDropped(MudItemDropInfo<BookChapter> dropItem)
    {
        if (selectedPlaylist?.BookChapters == null || dropItem?.Item == null) return;

        // Remember what is currently playing so we can keep the same segment after reorder
        var playingSegment = CurrentSegment?.Segment;

        var list = selectedPlaylist.BookChapters;
        list.Remove(dropItem.Item);

        var newIndex = dropItem.IndexInZone;
        if (newIndex < 0) newIndex = list.Count;
        if (newIndex > list.Count) newIndex = list.Count;
        list.Insert(newIndex, dropItem.Item);

        RebuildPlaylistSegments();

        // Preserve the currently playing segment (reorder is allowed while playing)
        if (playingSegment != null)
        {
            _currentSegmentIndex = _playlistSegments.FindIndex(s => s.Segment == playingSegment);
        }

        await SaveLibraryAsync();

        await InvokeAsync(() =>
        {
            _dropContainer?.Refresh();
            StateHasChanged();
        });
    }

    private async Task SaveLibraryAsync()
    {
        if (Library == null) return;

        try
        {
            var response = await Http.PutAsJsonAsync("library", Library);
            if (!response.IsSuccessStatusCode)
            {
                logger.LogWarning("Failed to save library after chapter reorder. Status: {StatusCode}", response.StatusCode);
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error saving library after chapter reorder");
        }
    }

    private async Task PlayCurrentSegment()
    {
        if (CurrentSegment == null || audioPlayer == null) return;        

        // Pause any currently playing audio / cancel speech
        await audioPlayer.PauseAsync();
        SetLoadingTrack(true);
        OnHasPlayedChanged(false); // Ensure HasPlayed is false before TTS starts
        
        var (chapter, segment) = CurrentSegment.Value;

        // === UX: Update the visible chapter/verse text IMMEDIATELY ===
        // so the user sees the new reference while hearing the VoiceText narration.
        SelectedBookChapter = new SelectedBookChapter
        {
            SelectedBook = chapter.BookNumber,
            SelectedChapter = chapter.ChapterNumber
        };

        chapterText = $"{chapter.Book?.Name} {chapter.ChapterNumber}:{segment.VerseStart}-{segment.VerseEnd}";

        // Force the UI (header text) to update right now, before TTS starts
        await InvokeAsync(() =>
        {
            _dropContainer?.Refresh();
            StateHasChanged();
        });
        
        // === TTS: Description (first segment) + BookChapter.VoiceText + Segment.VoiceText ===
        if (_enableTts)
        {            
            var textsToSpeak = new List<string>();
            bool isFirstSegment = _currentSegmentIndex == 0;

            if (isFirstSegment && !string.IsNullOrWhiteSpace(selectedPlaylist?.Description))
            {
                textsToSpeak.Add(selectedPlaylist.Description);
            }

            if (!string.IsNullOrWhiteSpace(chapter?.VoiceText))
            {
                textsToSpeak.Add(chapter.VoiceText);
            }

            if (!string.IsNullOrWhiteSpace(segment?.VoiceText))
            {
                textsToSpeak.Add(segment.VoiceText);
            }

            if (textsToSpeak.Any())
            {                
                await js.InvokeVoidAsync("speakSequenceAsync", textsToSpeak);
            }
        }        

        // Only after narration completes (and we were not cancelled) do we switch the actual audio source
        chapterAudio = $"{endpoints.Audio}{chapter.Chapter?.AudioUrl}";

        OnHasPlayedChanged(true); // Mark HasPlayed as true after TTS completes        
        SetLoadingTrack(false);
        await audioPlayer.ReloadAsync();
        
        _currentPlaybackTime = CurrentSegmentStart ?? 0m;
        _lastScrolledVerseId = null;
        _currentPlayingVerseId = null;
        StartPlaybackTimer();

        await InvokeAsync(() =>
        {
            _dropContainer?.Refresh();
            StateHasChanged();
        });

        await js.InvokeVoidAsync("ScrollToTop");
    }

    private async Task PlaySpecificSegment(BookChapter chapter, Segment segment)
    {
        if (chapter == null || segment == null) return;

        if (CurrentSegment.HasValue && CurrentSegment.Value.Chapter == chapter && CurrentSegment.Value.Segment == segment) return;        

        // Cancel any previous in-flight play before starting the new segment
        await CancelPlaybackAsync();

        _currentSegmentIndex = _playlistSegments.FindIndex(s => s.Segment == segment);
        await PlayCurrentSegment();
    }

    private async Task PlaySpecificVerse(BookChapter chapter, Segment segment, Verse verse)
    {
        if (chapter == null || segment == null || verse == null) return;

        if (CurrentSegment.HasValue && CurrentSegment.Value.Chapter == chapter && CurrentSegment.Value.Segment == segment)
        {
            // If the verse is already in the current segment, just seek to it
            _currentPlaybackTime = verse.AudioStart;           
            await audioPlayer.SeekAsync(_currentPlaybackTime);

            // Refresh highlight immediately after seek
            await InvokeAsync(() =>
            {
                _dropContainer?.Refresh();
                StateHasChanged();
            });
        }

    }

    private async Task GoToNextSegment()
    {
        if (_playlistSegments.Count == 0) return;

        await CancelPlaybackAsync();
        _currentSegmentIndex = (_currentSegmentIndex + 1) % _playlistSegments.Count;
        await PlayCurrentSegment();
    }

    private async Task GoToPreviousSegment()
    {
        if (_playlistSegments.Count == 0) return;

        await CancelPlaybackAsync();
        _currentSegmentIndex = (_currentSegmentIndex - 1 + _playlistSegments.Count) % _playlistSegments.Count;
        await PlayCurrentSegment();
    }

    protected async Task SelectBookChapter(BookChapter bookChapter, bool toggleMenu = true)
    {
        if (toggleMenu)
            hideVerses = !hideVerses;

        SelectedBookChapter ??= new SelectedBookChapter();
        SelectedBookChapter.SelectedChapter = bookChapter.ChapterNumber;
        SelectedBookChapter.SelectedBook = bookChapter.BookNumber;

        var selectedBook = bibleMenu?.Books?.FirstOrDefault(b => b.Number == SelectedBookChapter.SelectedBook);
        if (selectedBook != null)
        {
            chapterText = $"{selectedBook.Name} {SelectedBookChapter.SelectedChapter}";
            chapterAudio = $"{endpoints.Audio}{bookChapter.Chapter?.AudioUrl}";
        }

        // Clear segment tracking when manually selecting a full chapter
        _currentSegmentIndex = -1;

        if (toggleMenu)
        {
            hideChapters = !hideChapters;
            hide = !hide;
        }

        HasPlayed = true;
        await InvokeAsync(StateHasChanged);

        await js.InvokeVoidAsync("ScrollToTop");
        delegateLibrary.NotifyChapterChanged(this, new BiblePlaylist.Client.Delegates.EventArgs<SelectedBookChapter>(SelectedBookChapter));
    }

    protected async Task ChapterBack() => await GoToPreviousSegment();
    protected async Task ChapterForward() => await GoToNextSegment();

    private async Task AutoplayChanged(bool newState)
    {
        userSettings.Autoplay = newState;
        await localStorage.SetItemAsync("userName_settings", userSettings);
    }

    private async Task RepeatChanged(bool newState)
    {
        userSettings.Repeat = newState;
        await localStorage.SetItemAsync("userName_settings", userSettings);
    }

    private async Task EnableTtsChanged(bool newState)
    {
        if (userSettings != null)
        {
            userSettings.EnableTts = newState;
            await localStorage.SetItemAsync("userName_settings", userSettings);
        }
    }

    protected async Task OnTrackEnded()
    {        
        StopPlaybackTimer();

        if (Repeat && ((_currentSegmentIndex + 1) == _playlistSegments.Count))
        {
            _currentSegmentIndex = 0;
            await PlayCurrentSegment();
            return;
        }

        if (Autoplay && _playlistSegments.Any())
        {
            await GoToNextSegment();
        }        
    }

    public void Dispose()
    {
        StopPlaybackTimer();
    }

    private string GetPlaylistKey()
    {
        return Library?.Playlists?.FirstOrDefault(p => p.Name == selectedPlaylist?.Name)?.Key
               ?? selectedPlaylist?.Key
               ?? string.Empty;
    }

    private void NavigateToEdit(BookChapter chapter, Segment segment)
    {
        var playlistKey = GetPlaylistKey();
        var query = $"book={chapter.BookNumber}&chapter={chapter.ChapterNumber}&playlist={System.Net.WebUtility.UrlEncode(playlistKey)}&segmentStart={segment.VerseStart}&segmentEnd={segment.VerseEnd}";
        NavManager.NavigateTo($"/edit-segment?{query}");
    }

    private async Task DeleteSegment(BookChapter chapter, Segment segment)
    {
        if (chapter?.Segments == null || segment == null) return;

        chapter.Segments.Remove(segment);
        RebuildPlaylistSegments();
        _currentSegmentIndex = _playlistSegments.Any()
            ? _playlistSegments.FindIndex(s => s.Chapter == chapter)
            : -1;

        await SaveLibraryAsync();

        Snackbar.Add($"Segment '{segment.VerseStart}-{segment.VerseEnd}' deleted.", Severity.Info);

        await InvokeAsync(() =>
        {
            _dropContainer?.Refresh();
            StateHasChanged();
        });
    }
}
