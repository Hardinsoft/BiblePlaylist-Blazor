@page "/edit-segment"
@implements IDisposable
@using BiblePlaylist.Client.Events
@using BiblePlaylist.Client.Shared
@using BiblePlaylist.Shared.Bible
@using BiblePlaylist.Shared.DTO
@using BiblePlaylist.Shared.Playlist
@using BiblePlaylist.Shared.ExtensionMethods
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@using MudBlazor
@using System.Timers
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject IJSRuntime JSRuntime
@inject ILogger<SegmentEditor> logger
@inject IDelegateLibrary delegateLibrary
@inject Config.Endpoints endpoints
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-3">
    @if (!isInitialized)
    {
        <MudText>Loading...</MudText>
    }
    else if (!chapterLoaded)
    {
        @if (Book <= 0 || Chapter <= 0)
        {
            @* New-chapter segment from the playlist: no chapter yet, so
               pick one first. The playlist is already set on the URL. *@
            <MudText Typo="Typo.h5" Class="mb-3">Choose a chapter</MudText>
            <MudText Class="mb-3">Pick the chapter for the new segment.</MudText>
            <MudPaper Class="pa-2 mb-3" Elevation="1">
                <BiblePicker SelectedBook="Book" SelectedChapter="Chapter" OnChapterSelected="OnChapterSelected" />
            </MudPaper>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CancelEdit">Cancel</MudButton>
        }
        else
        {
            <MudAlert Severity="Severity.Error">
                Could not load chapter @Book @Chapter.
            </MudAlert>
        }
    }
    else
    {
        <!-- Top bar: chapter ref + Play/Stop + Save/Cancel -->
        <MudStack Row Spacing="2" Class="mb-3" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5" Class="flex-grow-1">@chapterReference</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="TogglePlayback">
                @if (_isPlaying)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Stop" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.PlayArrow" />
                }
                @(_isPlaying ? "Stop" : "Play Verses")
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSegment">Save</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CancelEdit">Cancel</MudButton>
            @* #41: switch chapters from the editor. Appended last so the
               first button in the row stays the Play button. *@
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ToggleBiblePicker">Change chapter</MudButton>
        </MudStack>

        @* #41: the Bible picker (book/chapter list, no audio player). *@
        @if (_showBiblePicker)
        {
            <MudPaper Class="pa-2 mb-3" Elevation="1">
                <BiblePicker SelectedBook="Book" SelectedChapter="Chapter" OnChapterSelected="OnChapterSelected" />
            </MudPaper>
        }

        @if (playlistLoadFailed)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">
                Could not load playlist. Check the playlist link and try again.
            </MudAlert>
        }

        @if (Mode == SegmentMode.Create && _selectedVerseNumbers.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                Select verses to create a new segment.
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                Verses: @(ShowSegmentRange()) · Time: @(FormatTime(SegmentDurationSeconds)) · Chapter length: @(FormatTime(ChapterTotalSeconds))
            </MudAlert>
        }

        @if (Mode == SegmentMode.Edit && _selectedVerseNumbers.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3">
                No verses selected. Either add verses or delete the segment.
            </MudAlert>
        }

        @* #39: optional intro text, spoken first (when TTS is on) and shown as
           the segment card's heading. Empty means today's behavior. *@
        <MudTextField @bind-Value="_introText" Label="Intro text (optional)"
                      Variant="Variant.Outlined" MaxLength="200" Counter="200"
                      Immediate="true"
                      HelperText="Spoken before the chapter and verses, and shown as the segment's heading."
                      Class="mb-3" />

        <!-- Verse list -->
        @foreach (var verse in displayVerses)
        {
            var verseNumber = verse.Number;
            var isSelected = _selectedVerseNumbers.Contains(verseNumber);
            var verseId = $"verse-{Book}-{verseNumber}";
            var isPlaying = isSelected && _currentPlayingVerseId == verseId;
            var verseStyle = isSelected
                ? "cursor: pointer; background-color: rgba(var(--mud-palette-primary-rgb), 0.10); border-left: 4px solid var(--mud-palette-primary);"
                : "cursor: pointer;";

            <MudPaper Class="pa-2 mb-2"
                      Style="@verseStyle">
                <div class="d-flex align-start" @onclick="() => ToggleVerseAsync(verseNumber)">
                    <MudText Typo="Typo.body1" Class="mr-3 font-weight-medium">@verseNumber</MudText>
                    <div class="flex-grow-1 @(isPlaying ? "playing-verse" : "")">
                        @(new MarkupString(verse.Html))
                    </div>
                </div>
            </MudPaper>
        }
    }
</MudContainer>

<!-- Hidden audio element for playback (always in DOM) -->
<audio id="segmentEditorAudioPlayer"
       class="w-100"
       style="max-height: 40px;">
    <source id="segmentEditorAudioPlayerSource" src="" type="audio/mpeg" />
</audio>

@code {
    private enum SegmentMode
    {
        Create,
        Edit
    }

    private bool isInitialized;
    private bool chapterLoaded;
    private bool playlistLoadFailed;
    private string chapterReference = string.Empty;
    private List<Verse> displayVerses = new();
    private HashSet<int> _selectedVerseNumbers = new();
    private string? _currentPlayingVerseId;
    private bool _isPlaying;
    private SegmentMode Mode = SegmentMode.Create;
    // #39: the intro text being edited (null/empty = no intro text).
    private string? _introText;
    // #41: whether the Bible picker panel is open; the chapter this load is for.
    private bool _showBiblePicker;
    private int _loadedBook = -1;
    private int _loadedChapter = -1;

    [Parameter] [SupplyParameterFromQuery] public int Book { get; set; }
    [Parameter] [SupplyParameterFromQuery] public int Chapter { get; set; }
    [Parameter] [SupplyParameterFromQuery] public string? Playlist { get; set; }
    [Parameter] [SupplyParameterFromQuery(Name = "library")] public string? LibraryCode { get; set; }
    [Parameter] [SupplyParameterFromQuery] public int SegmentId { get; set; }
    // #37: the Read page can pre-select a verse range for a new segment.
    [Parameter] [SupplyParameterFromQuery] public int SelectStart { get; set; }
    [Parameter] [SupplyParameterFromQuery] public int SelectEnd { get; set; }
    // #45: set to 1 when the editor was entered from the playlist's edit mode.
    // Carried through to the return URL so the playlist restores edit mode.
    [Parameter] [SupplyParameterFromQuery] public int Edit { get; set; }

    private decimal _segmentStartAudio;
    private decimal _segmentEndAudio;
    private string _chapterAudioUrl = string.Empty;
    private string _bookName = "";
    private System.Timers.Timer? _playbackTimer;
    private DotNetObjectReference<SegmentEditor>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        await LoadChapterForCurrentParametersAsync();
        isInitialized = true;
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        // #41: a chapter switch navigates to this same page with new query
        // parameters and the component instance is reused, so reload when
        // the chapter actually changed. The first call follows
        // OnInitializedAsync with the same parameters and is a no-op.
        if (isInitialized && (Book != _loadedBook || Chapter != _loadedChapter))
        {
            await LoadChapterForCurrentParametersAsync();
        }
        await base.OnParametersSetAsync();
    }

    /// <summary>
    /// (Re)loads the chapter the query parameters point at: Mode from the
    /// segmentId, per-chapter state reset, then the chapter load itself.
    /// </summary>
    private async Task LoadChapterForCurrentParametersAsync()
    {
        Mode = SegmentId != 0 ? SegmentMode.Edit : SegmentMode.Create;
        ResetEditorState();
        await LoadChapterAsync();
        _loadedBook = Book;
        _loadedChapter = Chapter;
    }

    /// <summary>
    /// #41: per-chapter state is reset before (re)loading a chapter — a
    /// chapter switch starts with a fresh empty selection and no intro text.
    /// </summary>
    private void ResetEditorState()
    {
        _selectedVerseNumbers = new HashSet<int>();
        _introText = null;
        _segmentStartAudio = 0;
        _segmentEndAudio = 0;
        _currentPlayingVerseId = null;
        _isPlaying = false;
        _showBiblePicker = false;
        playlistLoadFailed = false;
        chapterLoaded = false;
        displayVerses = new List<Verse>();
        StopPlaybackTimer();
    }

    private async Task LoadChapterAsync()
    {
        // A new-chapter segment from the playlist opens the editor with no
        // chapter yet (book/chapter 0): there is nothing to load — the
        // chapter picker below is the entry point, not an error.
        if (Book <= 0 || Chapter <= 0)
        {
            chapterLoaded = false;
            return;
        }

        try
        {
            var response = await Http.GetAsync($"Version?key={BiblePlaylist.Shared.Structs.Version.NET}&Book={Book}&Chapter={Chapter}");
            if (!response.IsSuccessStatusCode)
            {
                chapterLoaded = false;
                return;
            }

            var version = await response.Content.ReadFromJsonAsync<BiblePlaylist.Shared.Bible.Version>();
            if (version == null)
            {
                chapterLoaded = false;
                return;
            }

            var chapterObj = version.Books
                .Where(b => b.Number == Book)
                .SelectMany(b => b.Chapters)
                .FirstOrDefault(c => c.Number == Chapter);

            if (chapterObj == null)
            {
                chapterLoaded = false;
                return;
            }

            displayVerses = chapterObj.Verses?.ToList() ?? new List<Verse>();
            var rawAudioUrl = chapterObj.AudioUrl ?? "";
            _chapterAudioUrl = rawAudioUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || rawAudioUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
                ? rawAudioUrl
                : $"{endpoints.Audio}{rawAudioUrl}";

            chapterReference = $"{version.Books.FirstOrDefault(b => b.Number == Book)?.Name} {Chapter}";
            _bookName = version.Books.FirstOrDefault(b => b.Number == Book)?.Name ?? "";

            if (Mode == SegmentMode.Edit)
            {
                await LoadPlaylistAndSegmentAsync();
            }
            else
            {
                ApplyPreselection();
            }

            chapterLoaded = true;
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error loading chapter {Book} {Chapter}", Book, Chapter);
            chapterLoaded = false;
        }
    }

    private async Task LoadPlaylistAndSegmentAsync()
    {
        if (string.IsNullOrEmpty(Playlist))
        {
            Mode = SegmentMode.Create;
            return;
        }

        playlistLoadFailed = false;

        try
        {
            var libResponse = await Http.GetStringAsync($"library?key={LibraryCode}");
            var library = Newtonsoft.Json.JsonConvert.DeserializeObject<BiblePlaylist.Shared.Data.Library>(libResponse);
            if (library == null) return;

            // #25: retrofit Ids for segments saved before Id existed, so the
            // lookup below always has a stable identity to match on.
            library.EnsureSegmentIds();

            var playlist = library.Playlists?.FirstOrDefault(p => p.Key == Playlist);
            if (playlist == null) return;

            var bookChapter = playlist.BookChapters?
                .FirstOrDefault(bc => bc.BookNumber == Book && bc.ChapterNumber == Chapter);

            if (bookChapter?.Segments == null) return;

            var segment = bookChapter.Segments
                .FirstOrDefault(s => s.Id == SegmentId);

            if (segment != null)
            {
                Mode = SegmentMode.Edit;
                // #39: load the stored intro text into the field; saving
                // with it cleared removes it.
                _introText = segment.IntroText;
                // Verses list is not persisted in the library JSON (marked [JsonIgnore]);
                // derive the selection from VerseStart/VerseEnd + the chapter verses loaded earlier.
                var matchingVerses = displayVerses
                    .Where(v => v.Number >= segment.VerseStart && v.Number <= segment.VerseEnd)
                    .ToList();
                foreach (var v in matchingVerses)
                    _selectedVerseNumbers.Add(v.Number);
                _segmentStartAudio = matchingVerses.FirstOrDefault()?.AudioStart ?? 0;
                _segmentEndAudio = matchingVerses.LastOrDefault()?.AudioEnd ?? 0;
            }
            else
            {
                Mode = SegmentMode.Create;
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error loading playlist segment");
            playlistLoadFailed = true;
        }
    }

    /// <summary>
    /// #37: the Read page can pre-select a verse range (selectStart/selectEnd
    /// query parameters). Fill the selection from the range, keeping only the
    /// verses this chapter actually has; an invalid or out-of-range selection
    /// leaves the selection empty and the editor behaves as before.
    /// </summary>
    private void ApplyPreselection()
    {
        if (SelectStart <= 0 || SelectEnd < SelectStart) return;
        var numbers = displayVerses
            .Where(v => v.Number >= SelectStart && v.Number <= SelectEnd)
            .Select(v => v.Number)
            .ToList();
        if (numbers.Count == 0) return;
        foreach (var n in numbers)
            _selectedVerseNumbers.Add(n);
        RecomputeSegmentRange();
    }

    private string ShowSegmentRange()
    {
        if (_selectedVerseNumbers.Count == 0)
            return "not yet defined";

        var min = _selectedVerseNumbers.Min();
        var max = _selectedVerseNumbers.Max();
        return $"{min}-{max}";
    }

    private async Task ToggleVerseAsync(int verseNumber)
    {
        var wasPlaying = _isPlaying;
        var wasSelected = _selectedVerseNumbers.Contains(verseNumber);
        if (wasSelected)
            _selectedVerseNumbers.Remove(verseNumber);
        else
            _selectedVerseNumbers.Add(verseNumber);

        // #24: a segment is a contiguous range, so fill any gap the toggle opened.
        // What the user sees selected is then always exactly what will save
        // (SaveSegment stores min..max); without this, toggling 1 then 5
        // displayed {1, 5} but saved 1-5. Deselecting an endpoint shrinks the
        // range; deselecting an interior verse re-fills it (a no-op).
        if (_selectedVerseNumbers.Count > 0)
        {
            var minSelected = _selectedVerseNumbers.Min();
            var maxSelected = _selectedVerseNumbers.Max();
            for (var n = minSelected; n <= maxSelected; n++)
                _selectedVerseNumbers.Add(n);
        }

        RecomputeSegmentRange();

        if (wasPlaying)
        {
            if (_selectedVerseNumbers.Count == 0)
            {
                await StopPlaybackAsync();
            }
            else if (!wasSelected)
            {
                // Added while playing: start playing the newly selected verse.
                var verse = displayVerses.FirstOrDefault(v => v.Number == verseNumber);
                var start = verse?.AudioStart ?? _segmentStartAudio;
                await StartSegmentAudioAsync(start, _segmentEndAudio, speakTts: false);
            }
            else
            {
                // Removed while playing: keep playing the updated range from its start.
                await StartSegmentAudioAsync(_segmentStartAudio, _segmentEndAudio, speakTts: false);
            }
        }

        StateHasChanged();
    }

    private void RecomputeSegmentRange()
    {
        if (_selectedVerseNumbers.Count == 0)
        {
            _segmentStartAudio = 0;
            _segmentEndAudio = 0;
            return;
        }

        var minNum = _selectedVerseNumbers.Min();
        var maxNum = _selectedVerseNumbers.Max();

        var firstVerse = displayVerses.FirstOrDefault(v => v.Number == minNum);
        var lastVerse = displayVerses.FirstOrDefault(v => v.Number == maxNum);

        _segmentStartAudio = firstVerse?.AudioStart ?? 0;
        _segmentEndAudio = lastVerse?.AudioEnd ?? 0;
    }

    private async Task TogglePlayback()
    {
        if (_segmentStartAudio < 0 || _segmentEndAudio < 0 || _selectedVerseNumbers.Count == 0)
        {
            Snackbar.Add("Select at least one verse with valid audio bounds to play.", Severity.Warning);
            return;
        }

        if (_isPlaying)
        {
            await StopPlaybackAsync();
        }
        else
        {
            await StartSegmentAudioAsync(_segmentStartAudio, _segmentEndAudio, speakTts: true);
        }
        StateHasChanged();
    }

    private async Task StopPlaybackAsync()
    {
        await JSRuntime.InvokeVoidAsync("pauseAudioPlayer", "segmentEditorAudioPlayer");
        StopPlaybackTimer();
        _isPlaying = false;
        _currentPlayingVerseId = null;
    }

    private async Task StartSegmentAudioAsync(decimal start, decimal end, bool speakTts)
    {
        if (string.IsNullOrWhiteSpace(_chapterAudioUrl))
        {
            Snackbar.Add("Chapter audio is not available.", Severity.Warning);
            return;
        }

        _isPlaying = true;
        StateHasChanged();

        if (speakTts)
        {
            // TTS preview of what will be heard live: intro text first (#39),
            // then chapter voice text + segment voice text, as playlist
            // playback does. Not re-spoken on seeks while already playing.
            var texts = new List<string>();
            var intro = NormalizeIntroText(_introText);
            if (!string.IsNullOrWhiteSpace(intro))
                texts.Add(intro);
            if (!string.IsNullOrWhiteSpace(_bookName))
                texts.Add($"{_bookName} chapter {Chapter.NumberToText()}");
            if (_selectedVerseNumbers.Count > 0)
            {
                var min = _selectedVerseNumbers.Min();
                var max = _selectedVerseNumbers.Max();
                texts.Add(new Segment { VerseStart = min, VerseEnd = max }.VoiceText);
            }
            if (texts.Count > 0)
                await JSRuntime.InvokeVoidAsync("speakSequenceAsync", texts);
            // The user may have pressed Stop during TTS; pauseAudioPlayer cancels speech.
            if (!_isPlaying)
                return;
        }

        _dotNetRef ??= DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("initializeAudioPlayer", "segmentEditorAudioPlayer", _dotNetRef);
        await JSRuntime.InvokeVoidAsync("loadAudioFile", "segmentEditorAudioPlayer", "segmentEditorAudioPlayerSource", _chapterAudioUrl);
        await JSRuntime.InvokeVoidAsync("PlayAudioSegment", "segmentEditorAudioPlayer", "segmentEditorAudioPlayerSource", _chapterAudioUrl, start, end);
        StartPlaybackTimer();
        _isPlaying = true;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnAudioEnded()
    {
        StopPlaybackTimer();
        _isPlaying = false;
        _currentPlayingVerseId = null;
        await InvokeAsync(StateHasChanged);
    }

    private decimal ChapterTotalSeconds => displayVerses.Count == 0 ? 0 : displayVerses.Max(v => v.AudioEnd);

    private decimal SegmentDurationSeconds => _selectedVerseNumbers.Count == 0 ? 0 : Math.Max(0, _segmentEndAudio - _segmentStartAudio);

    private static string FormatTime(decimal seconds)
    {
        if (seconds < 0)
            seconds = 0;
        var total = (int)Math.Floor(seconds);
        return $"{total / 60}:{total % 60:D2}";
    }

    private string? ResolveCurrentVerseId(decimal time)
    {
        if (_selectedVerseNumbers.Count == 0)
            return null;

        var verse = displayVerses.FirstOrDefault(v =>
            _selectedVerseNumbers.Contains(v.Number) &&
            time >= v.AudioStart &&
            time <= v.AudioEnd);

        if (verse != null)
            return $"verse-{Book}-{verse.Number}";

        return null;
    }

    private async Task SaveSegment()
    {
        if (_selectedVerseNumbers.Count == 0)
        {
            Snackbar.Add("Select at least one verse to save a segment.", Severity.Warning);
            return;
        }

        var min = _selectedVerseNumbers.Min();
        var max = _selectedVerseNumbers.Max();
        var newSegment = new Segment
        {
            VerseStart = min,
            VerseEnd = max,
            // #39: trimmed on save; empty means no intro text (null, so it
            // is omitted from the saved JSON).
            IntroText = NormalizeIntroText(_introText)
        };

        await PersistSegmentAsync(newSegment);
    }

    /// <summary>
    /// #39: the intro text is trimmed on save and capped at 200 characters;
    /// empty or whitespace-only means no intro text (null).
    /// </summary>
    private static string? NormalizeIntroText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        var trimmed = value.Trim();
        return trimmed.Length > 200 ? trimmed[..200] : trimmed;
    }

    private void ToggleBiblePicker()
    {
        _showBiblePicker = !_showBiblePicker;
    }

    /// <summary>
    /// #41: a chapter picked in the Bible picker. In Create mode the switch
    /// is immediate (a selection belongs to the chapter it was made in, so
    /// the new chapter starts empty). In Edit mode the segment being edited
    /// belongs to the old chapter, so warn first — Greg's call: warn and
    /// confirm, not block — and switch only on confirm.
    /// </summary>
    private async Task OnChapterSelected((int Book, string BookName, int Chapter) selected)
    {
        _showBiblePicker = false;
        if (selected.Book == Book && selected.Chapter == Chapter)
            return;

        if (Mode == SegmentMode.Edit)
        {
            var parameters = new DialogParameters
            {
                ["TargetChapter"] = $"{selected.BookName} {selected.Chapter}"
            };
            var dialog = await DialogService.ShowAsync<ChangeChapterConfirmDialog>("Change chapter?", parameters);
            var result = await dialog.Result;
            if (result is not { Canceled: false, Data: true })
                return;
        }

        await SwitchChapterAsync(selected.Book, selected.Chapter);
    }

    private async Task SwitchChapterAsync(int book, int chapter)
    {
        await StopPlaybackAsync();
        NavManager.NavigateTo(BuildEditorUrl(book, chapter));
    }

    /// <summary>
    /// #41: the editor URL for a chapter switch. segmentId/selectStart/
    /// selectEnd are set explicitly to 0: [SupplyParameterFromQuery] only
    /// sets a parameter when the key is present, so omitting them would
    /// leave the old segment Id and pre-selection on the reused component.
    /// </summary>
    private string BuildEditorUrl(int book, int chapter)
    {
        var query = $"library={System.Net.WebUtility.UrlEncode(LibraryCode ?? string.Empty)}" +
                    $"&book={book}&chapter={chapter}" +
                    $"&playlist={System.Net.WebUtility.UrlEncode(Playlist ?? string.Empty)}" +
                    "&segmentId=0&selectStart=0&selectEnd=0";
        // #45: preserve the edit flag on a chapter switch.
        if (Edit != 0)
            query += "&edit=1";
        return $"/edit-segment?{query}";
    }

    private async Task PersistSegmentAsync(Segment segment)
    {
        if (string.IsNullOrEmpty(Playlist))
        {
            Snackbar.Add("Cannot save: playlist key is missing.", Severity.Error);
            return;
        }

        if (string.IsNullOrEmpty(LibraryCode))
        {
            Snackbar.Add("Cannot save: library code is missing.", Severity.Error);
            return;
        }

        try
        {
            var libResponse = await Http.GetStringAsync($"library?key={LibraryCode}");
            var library = Newtonsoft.Json.JsonConvert.DeserializeObject<BiblePlaylist.Shared.Data.Library>(libResponse);
            if (library == null)
            {
                Snackbar.Add("Could not load library for saving.", Severity.Error);
                return;
            }


            // #25: retrofit Ids for segments saved before Id existed, so the
            // lookup below matches the same Ids the editor loaded with.
            library.EnsureSegmentIds();

            var playlist = library.Playlists?.FirstOrDefault(p => p.Key == Playlist);
            if (playlist == null)
            {
                Snackbar.Add("Playlist not found.", Severity.Error);
                return;
            }

            var bookChapter = playlist.BookChapters?
                .FirstOrDefault(bc => bc.BookNumber == Book && bc.ChapterNumber == Chapter);

            if (bookChapter == null)
            {
                if (Mode != SegmentMode.Create)
                {
                    Snackbar.Add("Chapter not found in playlist.", Severity.Error);
                    return;
                }

                // #37: a new-chapter segment — create the chapter from the
                // data the editor already loaded, appended at the end of the
                // playlist (the playlist's own order is what matters).
                bookChapter = new BookChapter
                {
                    VersionCode = BiblePlaylist.Shared.Structs.Version.NET,
                    BookNumber = Book,
                    BookName = _bookName,
                    ChapterNumber = Chapter,
                    ChapterAudioUrl = _chapterAudioUrl,
                    Segments = new List<Segment>()
                };
                if (playlist.BookChapters == null)
                    playlist.BookChapters = new List<BookChapter>();
                playlist.BookChapters.Add(bookChapter);
            }

            if (Mode == SegmentMode.Edit)
            {
                // #25: identify the segment being edited by its stable Id
                // from the URL. Overlap between segments is allowed (Greg,
                // 2026-11-08), so a new range matching another segment is
                // fine — the Id is what identifies this segment.
                var existing = bookChapter.Segments?
                    .FirstOrDefault(s => s.Id == SegmentId);

                if (existing == null)
                {
                    Snackbar.Add("Original segment not found — it may have been deleted.", Severity.Error);
                    return;
                }

                if (bookChapter.Segments != null)
                {
                    // Keep the stable Id on the replacement.
                    segment.Id = existing.Id;
                    var idx = bookChapter.Segments.IndexOf(existing);
                    if (idx >= 0)
                        bookChapter.Segments[idx] = segment;
                }
            }
            else // Create mode
            {
                if (bookChapter.Segments == null)
                    bookChapter.Segments = new List<Segment>();
                bookChapter.Segments.Add(segment);
                // New segment gets the next Id in this chapter.
                Segment.EnsureIds(bookChapter.Segments);
            }

            // Verses are stripped server-side by Newtonsoft's [JsonIgnore] on
            // Segment.Verses (SaveEntityAsync). No client-side stripping needed;
            // the library here is a fresh deserialized copy from the GET endpoint
            // which already excludes Verses via the server's Newtonsoft round-trip.
            var response = await Http.PutAsJsonAsync("library", library);
            if (!response.IsSuccessStatusCode)
            {
                logger.LogWarning("Failed to save library. Status: {StatusCode}", response.StatusCode);
                Snackbar.Add("Save failed. See console for details.", Severity.Error);
                return;
            }

            Snackbar.Add($"Segment {segment.VerseStart}-{segment.VerseEnd} saved.", Severity.Success);
            NavManager.NavigateTo(BuildReturnUrl(segment.Id));
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error saving segment");
            Snackbar.Add("Save failed. See console for details.", Severity.Error);
        }
    }

    private void CancelEdit()
    {
        NavManager.NavigateTo(BuildReturnUrl(SegmentId));
    }

    private string BuildReturnUrl(int segmentId)
    {
        // No playlist supplied (e.g. Create with no playlist open): plain playlist list.
        if (string.IsNullOrEmpty(Playlist))
            return "/playlists";
        var query = $"playlist={System.Net.WebUtility.UrlEncode(Playlist)}&library={System.Net.WebUtility.UrlEncode(LibraryCode ?? string.Empty)}&book={Book}&chapter={Chapter}";
        if (segmentId > 0)
            query += $"&segmentId={segmentId}";
        // #45: carry the edit flag back so the playlist restores edit mode.
        if (Edit != 0)
            query += "&edit=1";
        return $"/playlists?{query}";
    }

    private void StartPlaybackTimer()
    {
        _playbackTimer?.Dispose();
        _playbackTimer = new System.Timers.Timer(300);
        _playbackTimer.Elapsed += async (s, e) =>
        {
            try
            {
                var time = await JSRuntime.InvokeAsync<double>("GetAudioCurrentTime", "segmentEditorAudioPlayer");
                var verseId = ResolveCurrentVerseId((decimal)time);
                if (verseId != null && verseId != _currentPlayingVerseId)
                {
                    _currentPlayingVerseId = verseId;
                    await JSRuntime.InvokeVoidAsync("scrollToVerse", verseId);
                    StateHasChanged();
                }
            }
            catch { }
        };
        _playbackTimer.Start();
    }

    private void StopPlaybackTimer()
    {
        _playbackTimer?.Stop();
        _playbackTimer?.Dispose();
        _playbackTimer = null;
    }

    public void Dispose()
    {
        StopPlaybackTimer();
        _dotNetRef?.Dispose();
    }
}
