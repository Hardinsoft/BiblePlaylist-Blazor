    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BiblePlaylist\Client\BiblePlaylist.Client.csproj" />
