{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/BiblePlaylist/Server/bin/Debug/net10.0/BiblePlaylist.Server.dll",
      "cwd": "${workspaceFolder}/BiblePlaylist/Server",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5108", // ← match your actual port
        "DOTNET_LAUNCH_PROFILE": "BiblePlaylist.Server"
      }
    },
    {
      "name": "Browser",
      "type": "blazorwasm",
      "request": "attach",
      "browser": "edge",
      "timeout": 120000,
      "url": "http://localhost:5108",
      "webRoot": "${workspaceFolder}/BiblePlaylist/Client/wwwroot",
      "inspectUri": "{wsProtocol}://localhost:5108/_framework/debug/ws-proxy?browser={browserInspectUri}"
    }
  ],
  "compounds": [
    {
      "name": "Blazor WASM Debug",
      "configurations": [
        "Server",
        "Browser"
      ]
    }
  ]
}