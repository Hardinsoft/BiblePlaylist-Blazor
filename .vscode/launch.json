{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/BiblePlaylist/Server/bin/Debug/net10.0/BiblePlaylist.Server.dll",
      "cwd": "${workspaceFolder}/BiblePlaylist/Server",      
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:5107",
        "DOTNET_LAUNCH_PROFILE": "BiblePlaylist.Server"
      }
    },
    {
      "name": "Browser",
      "type": "blazorwasm",
      "request": "attach",
      "browser": "edge",
      "timeout": 30000,
      "url": "https://localhost:5107",
      "webRoot": "${workspaceFolder}/BiblePlaylist/Client/wwwroot"
    }
  ],
  "compounds": [
    {
      "name": "Blazor WASM Debug",
      "configurations": ["Server", "Browser"]
    }
  ]
}
